</footer>

<!-- STICKY PLAYER -->
<div id="sticky-player">
    <div class="sp-progress-wrap" id="spProgressWrap">
        <div class="sp-progress-bar" id="spProgressBar"></div>
    </div>
    <div class="sp-cover"><div class="sp-cover-overlay"></div></div>
    <div class="sp-info">
        <div class="sp-track-name" id="spTrackName">Выберите трек</div>
        <div class="sp-track-artist">JEANNE VERSO</div>
    </div>
    <div class="sp-controls">
        <button class="sp-btn" id="spPrev"><i class="fas fa-backward-step"></i></button>
        <button class="sp-btn-main" id="spPlayPause"><i class="fas fa-play"></i></button>
        <button class="sp-btn" id="spNext"><i class="fas fa-forward-step"></i></button>
    </div>
    <div class="sp-time" id="spTime">0:00 / 0:00</div>
    <div class="sp-vol-wrap">
        <i class="fas fa-volume-low"></i>
        <input type="range" class="sp-vol" id="spVol" min="0" max="1" step="0.01" value="0.8">
        <i class="fas fa-volume-high"></i>
    </div>
</div>

<audio id="audioEl" preload="none"></audio>

<script>
/* LOADER */
window.addEventListener('load',()=>{ setTimeout(()=>document.getElementById('loader').classList.add('hidden'),2000); });

/* CURSOR */
const cur=document.getElementById('cursor'),curR=document.getElementById('cursorRing');
let mx=0,my=0,rx=0,ry=0;
document.addEventListener('mousemove',e=>{mx=e.clientX;my=e.clientY;});
(function animC(){rx+=(mx-rx)*.11;ry+=(my-ry)*.11;cur.style.left=mx+'px';cur.style.top=my+'px';curR.style.left=rx+'px';curR.style.top=ry+'px';requestAnimationFrame(animC);})();
document.querySelectorAll('a,button,.track-row').forEach(el=>{
    el.addEventListener('mouseenter',()=>{cur.style.width='18px';cur.style.height='18px';curR.style.width='52px';curR.style.height='52px';});
    el.addEventListener('mouseleave',()=>{cur.style.width='10px';cur.style.height='10px';curR.style.width='36px';curR.style.height='36px';});
});

/* SCROLL REVEAL */
const obs=new IntersectionObserver(entries=>{entries.forEach(e=>{if(e.isIntersecting)e.target.classList.add('visible');});},{threshold:0.1});
document.querySelectorAll('.reveal').forEach(el=>obs.observe(el));

/* NAVBAR */
window.addEventListener('scroll',()=>{
    document.querySelector('.navbar').style.borderBottomColor=window.scrollY>60?'rgba(230,57,70,.2)':'rgba(255,255,255,.07)';
});

/* TYPEWRITER */
const twEl=document.getElementById('typewriter');
const twWords=['Вокалистка мирового уровня','Педагог · Студия «Стань Звездой»','Париж · Берлин · Канны · Варшава','Только живой звук'];
let twIdx=0,twChar=0,twDel=false;
function tw(){
    const w=twWords[twIdx];
    if(!twDel){twEl.textContent=w.slice(0,++twChar);if(twChar===w.length){twDel=true;setTimeout(tw,2400);return;}setTimeout(tw,55);}
    else{twEl.textContent=w.slice(0,--twChar);if(twChar===0){twDel=false;twIdx=(twIdx+1)%twWords.length;setTimeout(tw,400);return;}setTimeout(tw,28);}
}
setTimeout(tw,1800);

/* AUDIO PLAYER */
const audio=document.getElementById('audioEl');
const player=document.getElementById('sticky-player');
const spName=document.getElementById('spTrackName');
const spPlay=document.getElementById('spPlayPause');
const spPrev=document.getElementById('spPrev');
const spNext=document.getElementById('spNext');
const spPBar=document.getElementById('spProgressBar');
const spPWrap=document.getElementById('spProgressWrap');
const spTime=document.getElementById('spTime');
const spVol=document.getElementById('spVol');
const rows=document.querySelectorAll('.track-row');
let curIdx=-1;

function fmt(s){if(isNaN(s)||!isFinite(s))return'0:00';const m=Math.floor(s/60),sec=Math.floor(s%60);return m+':'+(sec<10?'0':'')+sec;}

function loadTrack(idx){
    rows.forEach((r,i)=>{
        r.classList.remove('playing');
        r.querySelector('.track-play-btn i').className='fas fa-play';
    });
    rows[idx].classList.add('playing');
    rows[idx].querySelector('.track-play-btn i').className='fas fa-pause';
    curIdx=idx;
    audio.src=rows[idx].dataset.src;
    spName.textContent=rows[idx].dataset.title;
    player.classList.add('visible');
    spPlay.innerHTML='<i class="fas fa-pause"></i>';
    audio.play().catch(()=>{});
}

rows.forEach((row,i)=>{
    row.addEventListener('click',()=>{
        if(curIdx===i){
            if(audio.paused){audio.play();spPlay.innerHTML='<i class="fas fa-pause"></i>';row.querySelector('.track-play-btn i').className='fas fa-pause';row.classList.add('playing');}
            else{audio.pause();spPlay.innerHTML='<i class="fas fa-play"></i>';row.querySelector('.track-play-btn i').className='fas fa-play';row.classList.remove('playing');}
        } else {loadTrack(i);}
    });
});

spPlay.addEventListener('click',()=>{
    if(curIdx===-1){loadTrack(0);return;}
    if(audio.paused){audio.play();spPlay.innerHTML='<i class="fas fa-pause"></i>';rows[curIdx].classList.add('playing');rows[curIdx].querySelector('.track-play-btn i').className='fas fa-pause';}
    else{audio.pause();spPlay.innerHTML='<i class="fas fa-play"></i>';rows[curIdx].classList.remove('playing');rows[curIdx].querySelector('.track-play-btn i').className='fas fa-play';}
});

spPrev.addEventListener('click',()=>loadTrack(curIdx>0?curIdx-1:rows.length-1));
spNext.addEventListener('click',()=>loadTrack(curIdx<rows.length-1?curIdx+1:0));
audio.addEventListener('ended',()=>loadTrack(curIdx<rows.length-1?curIdx+1:0));

audio.addEventListener('timeupdate',()=>{
    if(!audio.duration)return;
    spPBar.style.width=(audio.currentTime/audio.duration*100)+'%';
    spTime.textContent=fmt(audio.currentTime)+' / '+fmt(audio.duration);
    if(rows[curIdx])rows[curIdx].querySelector('.track-dur').textContent=fmt(audio.duration);
});

spPWrap.addEventListener('click',e=>{
    if(!audio.duration)return;
    const r=spPWrap.getBoundingClientRect();
    audio.currentTime=((e.clientX-r.left)/r.width)*audio.duration;
});

spVol.addEventListener('input',()=>{audio.volume=parseFloat(spVol.value);});
audio.volume=0.8;
</script>
</body>
</html>
